// EJEMPLO COMPLETO DE DEEP LEARNING EN DEEPER
// Clasificación de empleados usando Perceptrón Multicapa

// 1. IMPORTAR LIBRERÍAS
importar patos como pt;
importar StanDeep como sd;
importar StanPlot como sp;
importar NumStan como ns;
importar StanMath como sm;

mostrar("=== CLASIFICACIÓN CON DEEP LEARNING ===");
mostrar("");

// 2. CARGAR Y EXPLORAR DATOS
mostrar("1. Cargando datos...");
dataframe df = pt.leer_csv("ejemplos/prueba.csv");

mostrar("Columnas disponibles:");
lista cols = df.columnas();
mostrar(cols);

// Obtener total de filas
entero total = df.contar_filas();

// 3. PREPROCESAMIENTO DE DATOS
mostrar("");
mostrar("2. Preprocesando datos...");

diccionario tipos = df.detectar_tipos();
mostrar("Tipos de columnas:");
mostrar(tipos);

// 4. PREPARAR MATRICES PARA LA RED
mostrar("");
mostrar("3. Preparando datos de entrenamiento...");

lista columnas_x = ["edad", "salario"];
matriz X_raw = df.to_matriz(columnas_x);

// Normalizar datos con Min-Max
diccionario X_norm_data = ns.normalizar_minmax(X_raw);
matriz X_norm = X_norm_data["matriz"];

mostrar("Datos normalizados (primeras 3 filas):");
entero j = 0;
entero lim = 3;
si total < 3:
    lim = total;
fin

mientras j < lim:
    mostrar(X_norm[j]);
    j = j + 1;
fin

// Extraer etiquetas
lista y = df.to_etiqueta("clase");
mostrar("Etiquetas:");
mostrar(y);

// Convertir a formato [ [clase], [clase], ... ] para todo el dataset
lista y_deep = [];
entero k = 0;
mientras k < total:
    lista etiqueta_vec = [y[k]];
    // concatenar
    y_deep = y_deep + [etiqueta_vec];
    k = k + 1;
fin

// 5. DIVISIÓN EN ENTRENAMIENTO/PRUEBA
mostrar("");
mostrar("4. Dividiendo datos...");

// Construimos entrenamiento con todas las filas excepto la última, y la última como prueba
matriz X_train = [];
lista y_train = [];
si total < 2:
    mostrar("No hay suficientes ejemplos para dividir en entrenamiento/prueba");
    // en este caso se podría abortar o usar todo para entrenamiento; aquí abortamos mostrando mensaje
sino:
    entero idx = 0;
    mientras idx < total - 1:
        X_train = X_train + [X_norm[idx]];
        y_train = y_train + [y_deep[idx]];
        idx = idx + 1;
    fin

    matriz X_test = [X_norm[total - 1]];
    lista y_test = [y_deep[total - 1]];

    mostrar("Tamaño entrenamiento:");
    mostrar(total - 1);
    mostrar("Tamaño prueba:");
    mostrar(1);
fin

// 6. CONSTRUIR RED NEURONAL
mostrar("");
mostrar("5. Construyendo red neuronal...");

sd.MLP.agregar_capa(2, 4, "relu");
sd.MLP.agregar_capa(4, 3, "relu");
sd.MLP.agregar_capa(3, 1, "sigmoid");
sd.MLP.compilar("entropia", 0.1);

mostrar("Red compilada con función de pérdida: entropía cruzada");

// 7. ENTRENAMIENTO
mostrar("");
mostrar("6. Entrenando la red...");
sd.MLP.entrenar(X_train, y_train, 50, 0.1, verdadero);

// 8. EVALUACIÓN
mostrar("");
mostrar("7. Evaluando modelo...");

decimal perdida_test = sd.MLP.evaluar(X_test, y_test);
mostrar("Pérdida en conjunto de prueba:");
mostrar(perdida_test);

// 9. PREDICCIONES
mostrar("");
mostrar("8. Haciendo predicciones...");

lista predicciones = sd.MLP.predecir(X_test);
mostrar("Predicción del ejemplo de prueba:");
mostrar(predicciones[0]);

decimal prob = predicciones[0][0];
entero clase_pred = 0;
si prob >= 0.5:
    clase_pred = 1;
fin

mostrar("Clase predicha:");
mostrar(clase_pred);
mostrar("Clase real:");
mostrar(y[total - 1]);

// 10. ANÁLISIS ESTADÍSTICO
mostrar("");
mostrar("9. Análisis estadístico de los datos...");

// Estadísticas de edad
lista edades = df.to_etiqueta("edad");
decimal edad_max = edades[0];
decimal edad_min = edades[0];

entero ii = 0;
mientras ii < total:
    si edades[ii] > edad_max:
        edad_max = edades[ii];
    fin
    si edades[ii] < edad_min:
        edad_min = edades[ii];
    fin
    ii = ii + 1;
fin

mostrar("Edad - Rango:");
mostrar(edad_min);
mostrar(edad_max);

// Estadísticas de salario
lista salarios = df.to_etiqueta("salario");
decimal salario_max = salarios[0];
decimal salario_min = salarios[0];

entero jj = 0;
mientras jj < total:
    si salarios[jj] > salario_max:
        salario_max = salarios[jj];
    fin
    si salarios[jj] < salario_min:
        salario_min = salarios[jj];
    fin
    jj = jj + 1;
fin

mostrar("Salario - Rango:");
mostrar(salario_min);
mostrar(salario_max);

// 11. GRAFICACIÓN
mostrar("");
mostrar("10. Visualizaciones...");

// Dispersión (asumimos sp.crear_dispersion)
sp.crear_dispersion(edades, salarios, "Edad vs Salario", "Edad", "Salario");

sp.guardar("grafica_dispersion.svg");


// Barras por cantidad de clases
entero conteo0 = 0;
entero conteo1 = 0;
entero a = 0;
mientras a < total:
    si y[a] == 0:
        conteo0 = conteo0 + 1;
    sino:
        conteo1 = conteo1 + 1;
    fin
    a = a + 1;
fin

lista categorias = ["Clase 0", "Clase 1"];
lista valores = [conteo0, conteo1];
sp.crear_barras(categorias, valores, "Distribución de clases", "", "");
sp.guardar("grafica_barras.svg");


// 12. RESUMEN FINAL
mostrar("");
mostrar("11. Proceso completado");
mostrar("");
mostrar("=== FIN DEL PROGRAMA ===");
