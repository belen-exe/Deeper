importar StanPlot;

lista x = [1, 2, 3, 4, 5];
lista y = [2, 4, 1, 8, 5];

StanPlot.crear_lineas(x, y, "Crecimiento", "Tiempo", "Valor");
StanPlot.color_linea(150, 20, 20);
StanPlot.color_puntos(10, 10, 200);
StanPlot.titulo("Gráfica de Lineas");
StanPlot.guardar("lineas.svg");

lista categorias = ["A", "B", "C", "D", "E"];
lista valores = [20, 10, 30, 15, 8];

StanPlot.crear_barras(categorias, valores, "Ventas", "Producto", "Cantidad");
StanPlot.color_barras(50, 100, 200);
StanPlot.guardar("barras.svg");
